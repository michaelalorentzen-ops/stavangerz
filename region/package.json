{
  "name": "stavanger-z",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "node scripts/client.mjs dev",
    "build": "node scripts/client.mjs build",
    "typecheck": "tsc --noEmit",
    "validate:world": "tsx scripts/validate-world.ts",
    "start": "node scripts/client.mjs start",
    "check:simulation": "tsx scripts/check-simulation.ts",
    "check:gameplay": "tsx scripts/check-gameplay.ts",
    "build:portable": "node scripts/build-portable.mjs",
    "build:vercel": "node scripts/prepare-vercel.mjs",
    "demo:simulation": "tsx scripts/demo-simulation.ts",
    "zones": "python -W ignore tools/zone-editor/server.py",
    "region:bot": "tsx scripts/region-bot.ts",
    "region:world": "python -W ignore tools/zone-editor/zonegame.py"
  },
  "dependencies": {
    "maplibre-gl": "6.16.0",
    "next": "16.4.3",
    "polygon-clipping": "0.15.7",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
